# Copy to `.env` for local runs of the action. Never commit the real values.
# In CI these come from GitHub repository secrets, not from a file.

GITHUB_TOKEN=
ANTHROPIC_API_KEY=

# Optional policy overrides (all have defaults — see action.yml).
REVIEW_STRICTNESS=balanced
REVIEW_ENFORCE_SECURITY=true
REVIEW_MIN_CONFIDENCE=0.6
REVIEW_MAX_COMMENTS=25
REVIEW_SEVERITIES=security,bug,optimization,nit
REVIEW_FAIL_ON_SEVERITY=none
REVIEW_MAX_DIFF_CHARS=180000
REVIEW_DRY_RUN=false
