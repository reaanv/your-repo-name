{
  "name": "autonomous-pr-reviewer",
  "version": "1.0.0",
  "private": true,
  "description": "Secure, automated PR code reviewer built on GitHub Actions + TypeScript + the Anthropic API.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard:start": "npm --prefix dashboard run start",
    "verify": "npm run typecheck && npm run test:unit && npm --prefix dashboard run typecheck && npm --prefix dashboard run build && npm run test:e2e"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^9.1.1",
    "@anthropic-ai/sdk": "^0.115.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
